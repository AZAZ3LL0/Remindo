ENV=dev                          # dev | test | prod
LOG_LEVEL=INFO
BOT_TOKEN=000000:fake-token-for-local-dev
BOT_MODE=polling                 # polling | webhook
BOT_USERNAME=reminder_bot        # without @, invitation links are built from it
WEBHOOK_BASE_URL=
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/reminder
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LANGUAGE=ru
PLANNER_HORIZON_HOURS=48
PLANNER_INTERVAL_SECONDS=60
DISPATCH_INTERVAL_SECONDS=10
DISPATCH_BATCH_SIZE=100
DELIVERY_LOCK_SECONDS=60
OCCURRENCE_TTL_MINUTES=180
DIGEST_WEEKDAY=1                 # ISO day, Monday is 1
DIGEST_HOUR=9                    # local hour of the recipient, not UTC
DIGEST_BATCH_SIZE=100
HEALTH_HOST=0.0.0.0              # worker healthcheck and metrics, not published outside compose
HEALTH_PORT=8080
ALERT_LAG_MINUTES=5              # delivery lag that raises an alert to ADMIN_USER_IDS
METRICS_WINDOW_MINUTES=15        # window the error share is measured over
BACKUP_DIR=/var/backups/reminder # read by scripts/backup.sh, not by Settings
BACKUP_KEEP_DAYS=14
USE_FAKE_BOT=false               # true — dev без реального токена
ADMIN_USER_IDS=
